# Environment — Backend
# Copy to .env and fill in real values

# ── Server ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Neon PostgreSQL ───────────────────────────────────
# Pooled connection for app runtime (PgBouncer) — from Neon dashboard
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Direct connection for migrations (prisma migrate) — from Neon dashboard
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# ── Redis (BullMQ) ────────────────────────────────────
# Upstash free tier: https://upstash.com → create Redis DB → copy URL
REDIS_URL="rediss://:your-token@us1-abc.upstash.io:6380"

# ── Email (Nodemailer SMTP) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Healthcare Manager <your_gmail@gmail.com>"

# ── Google OAuth 2.0 (Login & Google Calendar Sync) ──
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend-api.onrender.com/auth/google/callback

# ── LLM: Google Gemini ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── LLM: Groq (optional fallback) ────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Admin Seed ────────────────────────────────────────
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Super Admin

# ── Frontend URL (for CORS) ───────────────────────────
FRONTEND_URL=http://localhost:5173
